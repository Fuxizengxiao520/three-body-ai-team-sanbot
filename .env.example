# 复制为 .env 后填入真实值；.env 已加入 .gitignore
# ---------------------------------------------------------------
# xAI Grok（大脑）。留空即自动降级为离线 Mock 演示模式
XAI_API_KEY=
GROK_MODEL=grok-4-fast
XAI_BASE_URL=https://api.x.ai/v1/chat/completions

# auto=有 Key 用 Grok / grok=强制 Grok / mock=强制离线演示
SANBOT_LLM=auto

# 默认编制：trio(三人) / duo(两人) / full(七人完整)；命令行 --team 可临时覆盖
TEAM_PRESET=trio

# GitHub Issue bot / 推送脚本使用
# 建仓、读 Issue、发评论、开情报 Issue 需要 repo + issues 权限
GITHUB_TOKEN=
GITHUB_OWNER=Fuxizengxiao520
GITHUB_REPO=three-body-ai-team
GITHUB_REPOSITORY=

# 说明：GITHUB_TOKEN 要填 Personal Access Token（ghp_... 或 github_pat_... 开头），
# 不是邮箱、账号名或登录密码。生成时勾选 repo + workflow。
